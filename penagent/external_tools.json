{
  "note": "外部工具经 CLI 子进程接入。接入前请 git pull 到远程仓库最新版（本地可能滞后）。命令模板 {args} 展开：默认 --key value；positional=true 时按位置传值。RayScan v2.1.0 quick_scan/full_scan 目标硬编码（DVWA 实验室），待 wvs 库适配后以 adapter 接入。",
  "tools": {
    "poxiao_scan": {
      "description": "PoXiao 破晓 v3.1.0：SRC 漏洞扫描（技术栈识别+CVE 匹配+降噪）",
      "parameters": {"target": {"type": "string"}},
      "command": ["python", "${PENTEST_WS}/poxiao/poxiao.py",
                  "scan", "{args}"],
      "positional": true,
      "timeout": 600,
      "dangerous": true,
      "workdir": "${PENTEST_WS}/poxiao"
    },
    "poxiao_recon": {
      "description": "PoXiao 破晓 v3.1.0：域名被动信息收集（Whois/DNS/SSL/历史证书/子域名，quick 模式）",
      "parameters": {"domain": {"type": "string"}},
      "command": ["python", "${PENTEST_WS}/poxiao/poxiao.py",
                  "recon", "{args}", "--quick"],
      "positional": true,
      "timeout": 600,
      "dangerous": false,
      "workdir": "${PENTEST_WS}/poxiao"
    },
    "ruoyi_scan": {
      "description": "ruoyi-scan 若依专项漏洞扫描器",
      "parameters": {"target": {"type": "string"}},
      "command": ["python", "${PENTEST_WS}/ruoyi-scan/main.py", "{args}"],
      "timeout": 1200,
      "dangerous": true
    },
    "httpx_probe": {
      "description": "httpx：HTTP 探活与技术栈识别（状态码/标题/Server/CMS 指纹，JSON 输出）",
      "parameters": {"target": {"type": "string"}},
      "command": ["${PENTEST_TOOLS}/tools/httpx.exe", "-u",
                  "{args}", "-json", "-silent"],
      "positional": true,
      "timeout": 300,
      "dangerous": false
    },
    "fscan_scan": {
      "description": "fscan：端口扫描+服务识别+漏洞 POC（web 指纹/标题识别，爆破禁用）",
      "parameters": {"host": {"type": "string"}},
      "command": ["${PENTEST_TOOLS}/tools/fscan.exe", "-h",
                  "{args}", "-nobr", "-np", "-p",
                  "21,22,80,443,8000,8080,18080"],
      "positional": true,
      "timeout": 600,
      "dangerous": true
    },
    "nuclei_scan": {
      "description": "nuclei：模板漏洞扫描（2.5w+ 模板，技术/漏洞/CVE 检测）",
      "parameters": {"target": {"type": "string"}},
      "command": ["${PENTEST_TOOLS}/tools/nuclei.exe", "-u",
                  "{args}", "-silent"],
      "positional": true,
      "timeout": 600,
      "dangerous": true
    },
    "subfinder_enum": {
      "description": "subfinder：子域名被动枚举（多源聚合，v2.14）",
      "parameters": {"domain": {"type": "string"}},
      "command": ["${PENTEST_TOOLS}/tools/subfinder.exe", "-d",
                  "{args}", "-silent"],
      "positional": true,
      "timeout": 300,
      "dangerous": false
    },
    "dnsx_lookup": {
      "description": "dnsx：DNS 解析查询（A/AAAA/CNAME 等，-silent 输出 IP）",
      "parameters": {"domain": {"type": "string"}},
      "command": ["${PENTEST_TOOLS}/tools/dnsx.exe", "-d",
                  "{args}", "-silent", "-a"],
      "positional": true,
      "timeout": 120,
      "dangerous": false
    },
    "katana_crawl": {
      "description": "katana：爬虫 URL 收集（JS 渲染/表单/API 端点发现）",
      "parameters": {"url": {"type": "string"}},
      "command": ["${PENTEST_TOOLS}/tools/katana.exe", "-u",
                  "{args}", "-silent"],
      "positional": true,
      "timeout": 300,
      "dangerous": false
    },
    "naabu_scan": {
      "description": "naabu：快速端口扫描（SYN 探测，top 端口）",
      "parameters": {"host": {"type": "string"}},
      "command": ["${PENTEST_TOOLS}/tools/naabu.exe", "-host",
                  "{args}", "-silent", "-top-ports", "100"],
      "positional": true,
      "timeout": 300,
      "dangerous": true
    },
    "dalfox_xss": {
      "description": "dalfox：XSS 专项扫描（参数分析/DOM XSS 检测）",
      "parameters": {"target": {"type": "string"}},
      "command": ["${PENTEST_TOOLS}/tools/dalfox.exe", "url",
                  "{args}", "--silence"],
      "positional": true,
      "timeout": 600,
      "dangerous": true
    },
    "sqlmap_auto": {
      "description": "sqlmap：SQL 注入自动检测与利用（--batch 非交互，level 1 保守）",
      "parameters": {"url": {"type": "string"}},
      "command": ["sqlmap", "-u", "{args}", "--batch", "--level", "1",
                  "--risk", "1", "--random-agent"],
      "positional": true,
      "timeout": 1200,
      "dangerous": true
    },
    "gobuster_dir": {
      "description": "gobuster：目录/文件爆破（10k 通用字典，30 并发）",
      "parameters": {"url": {"type": "string"}},
      "command": ["${PENTEST_TOOLS}/tools/gobuster.exe", "dir",
                  "-u", "{args}", "-w",
                  "${PENTEST_TOOLS}/config/dictionaries/10k-most-common.txt",
                  "-t", "30", "-q"],
      "positional": true,
      "timeout": 600,
      "dangerous": true
    },
    "ffuf_fuzz": {
      "description": "ffuf：参数/路径 Fuzz（10k 字典，FUZZ 位置自动拼接）",
      "parameters": {"url": {"type": "string"}},
      "command": ["${PENTEST_TOOLS}/tools/ffuf.exe", "-u",
                  "{args}/FUZZ", "-w",
                  "${PENTEST_TOOLS}/config/dictionaries/10k-most-common.txt",
                  "-t", "30", "-s"],
      "positional": true,
      "timeout": 600,
      "dangerous": true
    },
    "ehole_finger": {
      "description": "ehole：红队重点系统指纹识别（fofa/资产指纹匹配）",
      "parameters": {"url": {"type": "string"}},
      "command": ["${PENTEST_TOOLS}/tools/ehole/EHole_windows_amd64/EHole_windows_amd64.exe",
                  "finger", "-u", "{args}"],
      "positional": true,
      "timeout": 300,
      "dangerous": false
    },
    "pocsuite_poc": {
      "description": "pocsuite3：PoC 框架批量验证（--batch 非交互）",
      "parameters": {"url": {"type": "string"}},
      "command": ["pocsuite", "-u", "{args}", "--batch"],
      "positional": true,
      "timeout": 1200,
      "dangerous": true
    }
  }
}
