{
  "note": "外部 MCP Server 注册表（声明式，不在此处连接）。路径按 AGENTS.md 第 7 条以绝对路径引用外部项目，不搬迁、不 vendor。discover_mcp() 时才真正连接；不可用的 server 不注册其工具。",
  "servers": {
    "rayscan": {
      "transport": "http",
      "url": "http://127.0.0.1:18000/mcp",
      "start": "python -m wvs mcp --host 127.0.0.1 --port 18000",
      "workdir": "${PENTEST_WS}/RayScan",
      "description": "RayScan 全栈 Web 扫描（工具：scan / list_modules / get_report）",
      "timeout": 60,
      "dangerous": true,
      "modes": ["pentest-standard"],
      "tool_overrides": {
        "list_modules": {"dangerous": false},
        "get_report": {"dangerous": false}
      }
    },
    "chameleon": {
      "transport": "stdio",
      "command": ["${PENTEST_WS}/Chameleon/.venv/Scripts/python.exe", "-m", "chameleon.interfaces.mcp_server"],
      "workdir": "${PENTEST_WS}/Chameleon",
      "pythonpath": "${PENTEST_WS}/Chameleon/src",
      "description": "Chameleon 反检测抓取（12 工具；三引擎 + 反爬升级）",
      "timeout": 60,
      "dangerous": false,
      "modes": [],
      "tool_overrides": {
        "crawl_site": {"dangerous": true},
        "map_site": {"dangerous": true}
      }
    },
    "seckb": {
      "transport": "stdio",
      "command": ["${PENTEST_WS}/seckb/.venv/Scripts/python.exe", "-c",
                  "from seckb.cli import main; main()", "mcp"],
      "workdir": "${PENTEST_WS}/seckb",
      "description": "seckb 本地网安知识库（1175+ 篇：kb_search 混合检索 / kb_card 知识卡片 / kb_get 正文切片 / kb_snippets 可执行片段）",
      "timeout": 60,
      "dangerous": false,
      "modes": []
    },
    "binwalk": {
      "transport": "stdio",
      "command": ["docker", "run", "-i", "--rm",
                  "-v", "${PENTEST_WS}/proteus-agent/data:/samples:ro",
                  "proteus-mcp-binwalk:latest"],
      "description": "binwalk 固件分析（扫描/提取/熵/hexdump 等 7 工具；分析文件经 data 目录只读挂载到 /samples——filepath 用容器内视角 /samples/...）",
      "timeout": 300,
      "dangerous": false,
      "modes": []
    },
    "searchsploit": {
      "transport": "stdio",
      "command": ["docker", "run", "-i", "--rm",
                  "proteus-mcp-searchsploit:latest"],
      "description": "Exploit-DB 离线检索（searchsploit_search：标题/路径/描述；无需挂载）",
      "timeout": 60,
      "dangerous": false,
      "modes": []
    },
    "capa": {
      "transport": "stdio",
      "command": ["docker", "run", "-i", "--rm",
                  "-v", "${PENTEST_WS}/proteus-agent/data:/samples:ro",
                  "proteus-mcp-capa:latest"],
      "description": "capa 二进制能力检测（MITRE ATT&CK 映射；分析文件经 /samples 只读挂载）",
      "timeout": 300,
      "dangerous": false,
      "modes": []
    },
    "cyberchef": {
      "transport": "stdio",
      "command": ["docker", "run", "-i", "--rm",
                  "-e", "CYBERCHEF_API_URL=http://host.docker.internal:3110/",
                  "proteus-cyberchef-mcp:latest"],
      "description": "CyberChef 编码/转换链（bake_recipe：Base64/hex/URL/压缩等全部 Chef 操作；依赖 proteus-cyberchef 容器在宿主 127.0.0.1:3110 运行——docker run --restart unless-stopped 常驻）",
      "timeout": 120,
      "dangerous": false,
      "modes": []
    }
  }
}
