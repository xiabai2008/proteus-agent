# 复制为 .env 后填入真实值；.env 不入库
PENTEST_LLM_BASE_URL=
PENTEST_LLM_API_KEY=
PENTEST_LLM_MODEL=

# 本机路径（按需配置，公开仓库零本机路径约定）
PENTEST_WS=
PENTEST_TOOLS=
PENTEST_PY312=
PENTEST_G07_ROOT=

# 沙箱容器镜像（缺省 python:3.12-slim）
# 想要 sandbox=docker 模式下隔离执行外部工具时，用专用镜像：
#   docker build -f docker/Dockerfile.sandbox -t proteus-sandbox:latest docker/
#   PENTEST_DOCKER_IMAGE=proteus-sandbox:latest
PENTEST_DOCKER_IMAGE=

# radare2 MCP（经 WSL 运行官方 r2mcp）（暂未接线：r2mcp tools/list 上游死锁）；
#   distro 指 WSL 发行版名，bin 为发行版内绝对路径
PENTEST_WSL_DISTRO=
PENTEST_R2MCP_BIN=
