# 沙箱专用镜像：在 python:3.12-slim 基础上预装隔离执行所需的工具。
#
# 为什么需要它（见 docs/修复待办清单.md R-15）：
# 默认的 python:3.12-slim 内**没有**宿主的外置工具（RsaCtfTool 等），而
# penagent/ctf_tools.json 的 `{python}` 会被展开为**宿主**解释器路径——
# 容器内既找不到那个路径，也没有对应工具。结果是：sandbox=docker 模式下
# 外部 CLI 工具的隔离执行实际不可用（只有内置 function 工具能跑）。
#
# 本镜像把工具装进容器，配合 DockerRunner 的命令容器化
# （penagent/sandbox.py），隔离执行才真正闭环。
#
# 构建：
#   docker build -f docker/Dockerfile.sandbox -t proteus-sandbox:latest docker/
#
# 启用（写进不入库的 .env）：
#   PENTEST_DOCKER_IMAGE=proteus-sandbox:latest
#
# 未配置该变量时仍用缺省 python:3.12-slim——隔离执行的路径适配仍然正确
# （见 CONTAINER_WORKDIR），只是没有外置工具可用。
FROM python:3.12-slim

# CTF 模式 rsactf_attack 的依赖：RsaCtfTool 及其密码学后端。
#
# **RsaCtfTool 不在 PyPI**（发行名 rsactftool 查询无结果），只能从 GitHub 装。
# 而当前网络下 github.com **直连不可达**（宿主与容器实测均超时），故默认走
# GitHub 代理；代理从两侧都可达（实测 200），且能直连时用 --build-arg 覆盖：
#   docker build --build-arg RSACTFTOOL_BASE=https://github.com \
#                -f docker/Dockerfile.sandbox -t proteus-sandbox:latest docker/
#
# 钉住 commit（与本机安装的 direct_url.json 一致）保证可复现。
ARG RSACTFTOOL_BASE=https://ghproxy.net/https://github.com
ARG RSACTFTOOL_COMMIT=7c98848f1945de3e67a420871e8672f5ad9aa5d5
# 不显式列 pycryptodome：RsaCtfTool 自带该依赖（钉的是 3.10.4），再显式装最新版
# 会引入版本冲突（实测 build 失败，而单独装 tarball 成功）。
RUN pip install --no-cache-dir \
      "${RSACTFTOOL_BASE}/RsaCtfTool/RsaCtfTool/archive/${RSACTFTOOL_COMMIT}.tar.gz"

# 构建期自检：装不上就让构建失败，而不是等到运行时才发现
RUN python -c "import RsaCtfTool; print('RsaCtfTool ready')"

# 说明：python_solve 只需容器自带的 python（`python -c`），无需额外安装。

# ----------------------------------------------------------------------
# 渗透工具（R-15 扩展）
#
# 选择标准：**零配置依赖**——装上就能用，不需要额外的模板 / 字典 / PoC 文件
# （那些在容器里没有，装了工具也跑不起来）。
#   - sqlmap：SQL 注入检测，内置检测逻辑，无需外部数据文件
#
# 未装及原因（诚实记录，不是遗漏）：
#   - nuclei：需要 templates 仓库（容器内无，且首次运行要联网下载）
#   - ffuf / gobuster：需要字典（宿主 ${PENTEST_TOOLS}/config/dictionaries/）
#   - pocsuite3：需要 PoC 文件
#   - fscan / naabu / dalfox：**已于 R-15 第三轮纳入**（见下方 Go 工具段）
#
# **网络语义（重要）**：容器内的 `127.0.0.1` 是**容器自己**，不是宿主。要访问
# 宿主上的靶场/服务须用 `host.docker.internal`（且工具要在 external_tools.json
# 里声明 `network=true` 才会走 bridge 而非 `--network none`）。实测：
# `--network none` 下两个地址都不可达；`--network bridge` 下只有
# host.docker.internal 可达。
RUN pip install --no-cache-dir sqlmap

# ----------------------------------------------------------------------
# 渗透工具 · Go 二进制（R-15 第三轮扩容）
#
# 纳入 fscan / naabu / dalfox，选择依据与上同理：**零配置依赖**——功能内建，
# 不需要模板仓库或字典文件，装进容器即可真扫（nuclei / ffuf / gobuster 仍不
# 纳入，原因见上）。
#
# **代理选择（实测证据）**：github.com 直连不可达（code=000）。两个公共代理
# 实测：ghproxy.net 吞吐约 43KB/s 且 11.8MB 的 naabu 资产**被截断**（只取到
# 5.2MB）；gh-proxy.com 约 5.8MB/s、三个资产完整。故本段默认走 gh-proxy.com；
# rsactftool 段的 ghproxy.net 保持原样（其资产小，已验证可用）。
# 直连可用时覆盖：--build-arg GO_TOOLS_BASE=https://github.com
ARG GO_TOOLS_BASE=https://gh-proxy.com/https://github.com
# 多架构映射：amd64 -> fscan x64 / naabu amd64 / dalfox x86_64；
# arm64 -> fscan arm64 / naabu arm64 / dalfox aarch64（TARGETARCH 由
# BuildKit 注入，缺省 amd64）。
ARG TARGETARCH=amd64
# **版本 + 官方 sha256 双钉**：这三个二进制会在隔离容器里以 root 执行，
# 下载内容被篡改或被代理换成别的构建，等于让沙箱执行来路不明的代码——
# 故校验不过直接让构建失败（不是警告）。
ARG FSCAN_VERSION=2.2.0
ARG FSCAN_SHA256=0ed5b96fd3637fbce3e2e990761e8445352e0ba10e8914c98b0dfa993c1357c3
ARG NAABU_VERSION=2.6.1
ARG NAABU_SHA256=018c4c9884dea971eda860435ede3021d1150732f34cfd245498c6726d8cab90
ARG DALFOX_VERSION=3.2.0
ARG DALFOX_SHA256=1c0539081951ce5f847bd7b62a360fbd4080248502d09a83ce25c5b234f61b8c

# 用镜像自带的 python 下载/校验/解包（不引入 curl / unzip，少一层 apt）。
RUN python - <<'PY'
import hashlib, os, tarfile, urllib.request, zipfile
from io import BytesIO

base = os.environ["GO_TOOLS_BASE"]
suffix = {"amd64": ("x64", "amd64", "x86_64"),
          "arm64": ("arm64", "arm64", "aarch64")}.get(
              os.environ.get("TARGETARCH", "amd64"))
if suffix is None:
    raise SystemExit(f"未映射的架构: {os.environ.get('TARGETARCH')}")
f_arch, n_arch, d_arch = suffix

fv = os.environ["FSCAN_VERSION"]
nv = os.environ["NAABU_VERSION"]
dv = os.environ["DALFOX_VERSION"]
assets = {
    "fscan": (f"shadow1ng/fscan/releases/download/v{fv}/fscan_{fv}_linux_{f_arch}",
              os.environ["FSCAN_SHA256"]),
    "naabu": (f"projectdiscovery/naabu/releases/download/v{nv}/"
              f"naabu_{nv}_linux_{n_arch}.zip", os.environ["NAABU_SHA256"]),
    "dalfox": (f"hahwul/dalfox/releases/download/v{dv}/"
               f"dalfox-v{dv}-linux-{d_arch}.tar.gz", os.environ["DALFOX_SHA256"]),
}

for name, (path, want) in assets.items():
    url = f"{base}/{path}"
    blob = urllib.request.urlopen(url, timeout=300).read()
    got = hashlib.sha256(blob).hexdigest()
    if got != want:
        raise SystemExit(f"{name}: sha256 不匹配\n  期望 {want}\n"
                         f"  实得 {got}\n  来源 {url}")
    if path.endswith(".zip"):
        with zipfile.ZipFile(BytesIO(blob)) as z:
            data = z.read(name)
    elif path.endswith(".tar.gz"):
        with tarfile.open(fileobj=BytesIO(blob), mode="r:gz") as t:
            member = next(m for m in t.getmembers()
                          if m.name.endswith("/" + name))
            data = t.extractfile(member).read()
    else:
        data = blob
    dest = os.path.join("/usr/local/bin", name)
    with open(dest, "wb") as fh:
        fh.write(data)
    os.chmod(dest, 0o755)
    print(f"{name} ready ({len(data)} bytes, sha256 {got[:12]}...)")
PY

# 构建期自检：三个二进制能跑起来、报出自己的版本（管道取 grep 的退出码，
# 故工具自身的退出码不影响判定）。真正"能扫"的证据在 tests/test_sandbox.py。
RUN naabu -version 2>&1 | grep -q "Current Version" \
 && dalfox version 2>&1 | grep -qi "Dalfox" \
 && fscan 2>&1 | grep -q "Fscan ${FSCAN_VERSION}"

# ----------------------------------------------------------------------
# 渗透工具 · 需要模板/字典的那些（R-15 第四轮）
#
# 前三轮只纳入"零配置依赖"的工具；nuclei / ffuf / gobuster 一直被排除，理由是
# 它们要模板或字典文件，容器里没有（装了也跑不起来）。本轮的解法**不是把数据
# 打进镜像**（体积大、更新频繁、逐机不同），而是**只读挂载宿主的数据目录**
# （见 penagent/sandbox.py 的 host_data_mounts / containerize_command）：
#
#   ${PENTEST_TOOLS}              → /opt/host-tools
#       spec 里的 `${PENTEST_TOOLS}/config/dictionaries/10k-most-common.txt`
#       在容器化时按根重写为 `/opt/host-tools/config/dictionaries/...`
#   <用户主目录>/nuclei-templates → /root/nuclei-templates
#       nuclei 的**默认**模板目录，故 spec 不必加 `-t`
#
# 两处挂载都不存在时容器照样起得来，只是对应工具会以**自己的报错**暴露缺数据
# （不静默降级）。PoC 同理：pocsuite 不带 -r 时用自带的 poc 目录，零数据即可跑。
#
# 版本 + 官方 sha256 双钉（取自各 release 的 checksums.txt）；不匹配即构建失败。
ARG TOOLS_BASE=https://gh-proxy.com/https://github.com
ARG NUCLEI_VERSION=3.11.1
ARG NUCLEI_SHA256_AMD64=ea63d4ae232808cd7c6bc00d0142428e231fab59dae01042246097d195835ab6
ARG NUCLEI_SHA256_ARM64=8044e3d9768ba0a744b2872c1a87e813006f013da97ca9f50f7661a4203bec07
ARG FFUF_VERSION=2.3.0
ARG FFUF_SHA256_AMD64=b2a3c725fcb9da175159682f54d6e9149f2905b00d84d155e7efc5d599975ceb
ARG FFUF_SHA256_ARM64=e2d712615d53da797ee929006e41f2df5a7960a5353133db9c150ddaa22ae4e8
ARG GOBUSTER_VERSION=3.8.2
ARG GOBUSTER_SHA256_AMD64=c8a8c6a966eeb011d682a0ef2305a3e3a86b8b3fabe744350c00a766cc0f8021
ARG GOBUSTER_SHA256_ARM64=84b175ae5ae770efddb3e675b0e24e56ef0f484a0d751beff0b0629e52c7f4da

RUN python - <<'PY'
import hashlib, os, tarfile, urllib.request, zipfile
from io import BytesIO

base = os.environ["TOOLS_BASE"]
arch = os.environ.get("TARGETARCH", "amd64")
if arch not in ("amd64", "arm64"):
    raise SystemExit(f"未映射的架构: {arch}")
up = arch.upper()
nv = os.environ["NUCLEI_VERSION"]
fv = os.environ["FFUF_VERSION"]
gv = os.environ["GOBUSTER_VERSION"]
g_arch = "x86_64" if arch == "amd64" else "arm64"
assets = {
    "nuclei": (f"projectdiscovery/nuclei/releases/download/v{nv}/"
               f"nuclei_{nv}_linux_{arch}.zip",
               os.environ[f"NUCLEI_SHA256_{up}"], "nuclei"),
    "ffuf": (f"ffuf/ffuf/releases/download/v{fv}/"
             f"ffuf_{fv}_linux_{arch}.tar.gz",
             os.environ[f"FFUF_SHA256_{up}"], "ffuf"),
    "gobuster": (f"OJ/gobuster/releases/download/v{gv}/"
                 f"gobuster_Linux_{g_arch}.tar.gz",
                 os.environ[f"GOBUSTER_SHA256_{up}"], "gobuster"),
}

for name, (path, want, member) in assets.items():
    blob = urllib.request.urlopen(f"{base}/{path}", timeout=300).read()
    got = hashlib.sha256(blob).hexdigest()
    if got != want:
        raise SystemExit(f"{name}: sha256 不匹配\n  期望 {want}\n"
                         f"  实得 {got}\n  来源 {path}")
    if path.endswith(".zip"):
        with zipfile.ZipFile(BytesIO(blob)) as z:
            data = next(z.read(n) for n in z.namelist()
                        if os.path.basename(n) == member)
    else:
        with tarfile.open(fileobj=BytesIO(blob), mode="r:gz") as t:
            # gobuster 的 tarball 是**裸文件**（无目录前缀），故按 basename 找成员
            data = next(t.extractfile(m).read() for m in t.getmembers()
                        if os.path.basename(m.name) == member)
    dest = os.path.join("/usr/local/bin", name)
    with open(dest, "wb") as fh:
        fh.write(data)
    os.chmod(dest, 0o755)
    print(f"{name} ready ({len(data)} bytes, sha256 {got[:12]}...)")
PY

# pocsuite3：PoC 验证框架（零数据依赖即可跑自带 PoC）。
RUN pip install --no-cache-dir pocsuite3

# 构建期自检：装上了、能报版本（"真的能扫"的证据在 tests/test_sandbox.py）。
# gobuster 3.8.x 用 `--version`（旧的 `version` 子命令已被移除——2026-09-23 实测
# `No help topic for 'version'`，别再用旧写法）。
# 先逐条打印实况（set -x + 直接输出），再跑 grep 断言——失败时日志里能直接
# 看到"哪个工具、什么输出"，不用再做诊断构建（2026-09-23 排查教训）。
RUN set -x; \
    nuclei -version 2>&1 | head -2; \
    ffuf -V 2>&1 | head -1; \
    gobuster --version 2>&1 | head -1; \
    python -c "import pocsuite3; print('pocsuite3', pocsuite3.__version__)"; \
    nuclei -version 2>&1 | grep -qi nuclei \
 && ffuf -V 2>&1 | grep -qi ffuf \
 && gobuster --version 2>&1 | grep -q "${GOBUSTER_VERSION}" \
 && python -c "import pocsuite3"


# ----------------------------------------------------------------------
# CTF 解题/逆向/取证工具（2026-09-23，规划 T0：工具生态补强）
#
# 选择标准沿用上文：装上就能用、不依赖宿主侧数据文件。
#   - pwntools：exploit 开发框架（pwn 脚本基建；纯 pip，离线可用）
#   - checksec.py：ELF 保护检查（pip 版，自带能力）
#   - volatility3：内存取证框架（自带核心插件；镜像样本另供）
#   - binwalk：固件/文件雕刻（apt 版 v2，签名库内置）
#   - gdb / strace / ltrace / file / xxd：二进制分析基础件（apt）
#
# apt 源默认 deb.debian.org；构建网络受限时可用国内镜像覆盖：
#   docker build --build-arg APT_MIRROR=mirrors.tuna.tsinghua.edu.cn ...
ARG APT_MIRROR=deb.debian.org
RUN set -eux; \
    if [ -f /etc/apt/sources.list.d/debian.sources ]; then \
      sed -i "s|deb.debian.org|${APT_MIRROR}|g; s|security.debian.org|${APT_MIRROR}|g" \
          /etc/apt/sources.list.d/debian.sources; \
    fi; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
        gdb binwalk file xxd strace ltrace; \
    rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir pwntools checksec.py volatility3

# 构建期自检：每个工具都要能报告自己（装不上=构建失败，不留半残镜像）。
# 踩坑记录（2026-09-23）：
#   - pwntools 用 CLI `pwn version`（`pwn` 模块没有 __version__ 属性）
#   - volatility3 用 CLI `vol`（模块顶层同样没有 __version__）
RUN pwn version 2>&1 | head -1 \
 && python -c "import checksec; print('checksec.py ok')" \
 && vol --help >/dev/null 2>&1 \
 && binwalk --help >/dev/null 2>&1 \
 && gdb --version | head -1

# ---- T2 扩层（2026-09-24）：SAST + OSINT 三件 -----------------------------
# semgrep：代码审计（SAST，规则扫描 --config auto）；sherlock：OSINT 用户名
# 枚举；theHarvester：情报收集。⚠️ PyPI 上的 theHarvester 是 0.0.1 占位假包
# （无模块无 CLI，实测）；且 master 分支已要求 Python>=3.14——
# 钉 4.11.1 tag（实测兼容 3.12）。
# pypi 走清华镜像（直连实测读超时，同 docker/mcp 策略）。
RUN pip install --no-cache-dir -i ${PIP_MIRROR:-https://pypi.tuna.tsinghua.edu.cn/simple} \
      semgrep sherlock-project \
 && pip install --no-cache-dir -i ${PIP_MIRROR:-https://pypi.tuna.tsinghua.edu.cn/simple} \
      "https://gh-proxy.com/https://github.com/laramies/theHarvester/archive/refs/tags/4.11.1.zip"

# 自检：严格模式（不用管道吞错——command -v / 显式退出码）
RUN semgrep --version \
 && sherlock --version >/dev/null 2>&1 \
 && command -v theHarvester \
 && theHarvester -h >/dev/null 2>&1 \
 && echo "T2 三件就位"
